{
  "headers": [
    { "source": "/assets/(stills|fonts|img)/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=604800" }] },
    { "source": "/assets/(css|js)/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=600, stale-while-revalidate=86400" }] },
    { "source": "/assets/favicon.svg", "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }] }
  ]
}
